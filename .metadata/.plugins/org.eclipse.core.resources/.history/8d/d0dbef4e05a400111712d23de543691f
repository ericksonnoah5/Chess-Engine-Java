package pieces;

import chess_game.piece;

public class player extends piece{
	
String visualchar="[@]";

	piece standingOn;

	int x;
	int y;

	public player() {
		setVisual(visualchar);

	}
	public player(int x, int y) {
		setVisual(visualchar);
		this.x=x;
		this.y=y;
		
	}
	
	
	
	
	
	
	public void setX(int x) {
		this.x=x;
	}
	public void setY(int y) {
		this.y=y;
	}
	public int getY() {
		return y;
	}
	public int getX() {
		return x;
	}
	
	public piece getStandingOn() {
		return standingOn;
	}
	
	
	
	public void moveUp() {
		if(y<=0 || y>=7) {
		}
		else {
			y++;
		}
	}
	public void moveDown() {
		if(y<=0 || y>=7) {
		}
		else {
			y--;
		}
	}
	public void moveLeft() {
		if(x<=0 || x>=7) {
		}
		else {
			x--;
		}
	}
	public void moveRight() {
		if(x<=0 || x>=7) {
		}
		else {
			x++;
		}
}
	
}
